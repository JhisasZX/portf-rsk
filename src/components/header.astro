---
const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en');
---
<header class="sticky top-0 w-full z-40">
  <div class="backdrop-blur-xl bg-[#0a0a0a]/75 border-b border-white/[0.06] transition-all duration-300">
    <div class="flex justify-between items-center py-4 max-w-6xl mx-auto px-4 w-full">
      <!-- DESKTOP NAV -->
      <nav class="hidden md:flex flex-row gap-x-8 opacity-80 text-sm font-medium">
          <a href={isEn ? "/en#top" : "#top"} class="hover:text-purple-400 transition-colors">{isEn ? 'Home' : 'Inicio'}</a>
          <a href={isEn ? "/en#experiencia" : "#experiencia"} class="hover:text-purple-400 transition-colors">{isEn ? 'Experience' : 'Experiencia'}</a>
          <a href={isEn ? "/en#proyectos" : "#proyectos"} class="hover:text-purple-400 transition-colors">{isEn ? 'Projects' : 'Proyectos'}</a>
          <a href={isEn ? "/en#charlas" : "#charlas"} class="hover:text-purple-400 transition-colors">{isEn ? 'Talks' : 'Charlas'}</a>
          <a href={isEn ? "/en#stack" : "#stack"} class="hover:text-purple-400 transition-colors">Stack</a>
          <a href={isEn ? "/en#contacto" : "#contacto"} class="hover:text-purple-400 transition-colors">{isEn ? 'Contact' : 'Contacto'}</a>
      </nav>

      <!-- LANG SWITCH & MOBILE BTN -->
      <div class="flex items-center gap-4 ml-auto">
          <div class="flex items-center text-xs font-semibold px-2.5 py-1 rounded-full bg-white/[0.05] border border-white/10">
              <a href="/" class={isEn ? "text-neutral-400 hover:text-white transition-colors px-1" : "text-white font-bold px-1"}>ES</a>
              <span class="text-neutral-600">/</span>
              <a href="/en" class={isEn ? "text-white font-bold px-1" : "text-neutral-400 hover:text-white transition-colors px-1"}>EN</a>
          </div>

          <button id="mobile-menu-btn" class="md:hidden text-white p-2 focus:outline-none relative z-[1001] rounded-lg hover:bg-white/10 transition-colors" aria-label="Menu">
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="menu-icon"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="close-icon hidden"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
      </div>
    </div>
  </div>
</header>

<!-- MOBILE MENU OVERLAY (Direct child of component, not trapped by backdrop-filter) -->
<div 
  id="mobile-menu" 
  class="fixed inset-0 w-full h-[100dvh] bg-[#0a0a0a]/98 backdrop-blur-2xl z-[999] flex flex-col items-center justify-between translate-x-full transition-transform duration-300 md:hidden overflow-y-auto px-6 pt-24 pb-12"
>
  <div class="flex flex-col items-center shrink-0">
    <div class="relative mb-3">
      <img 
        src="https://res.cloudinary.com/dmegzyenk/image/upload/v1763726957/me_cs_doqcyr.jpg" 
        alt="Jesús Machicado" 
        class="w-24 h-24 rounded-full object-cover border-2 border-purple-500/40 shadow-[0_0_35px_rgba(168,85,247,0.35)] shrink-0" 
      />
      <span class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-emerald-400 border-2 border-[#0a0a0a]"></span>
    </div>
    <span class="text-base font-semibold text-white">Jesús Machicado</span>
    <span class="text-xs font-mono text-purple-300 uppercase tracking-widest mt-0.5">Tech Lead &bull; Mobile</span>
  </div>
  
  <nav class="flex flex-col items-center gap-y-5 text-xl font-light tracking-wide my-auto py-6">
      <a href={isEn ? "/en#top" : "#top"} class="mobile-link hover:text-purple-400 transition-colors py-1">{isEn ? 'Home' : 'Inicio'}</a>
      <a href={isEn ? "/en#experiencia" : "#experiencia"} class="mobile-link hover:text-purple-400 transition-colors py-1">{isEn ? 'Experience' : 'Experiencia'}</a>
      <a href={isEn ? "/en#proyectos" : "#proyectos"} class="mobile-link hover:text-purple-400 transition-colors py-1">{isEn ? 'Projects' : 'Proyectos'}</a>
      <a href={isEn ? "/en#charlas" : "#charlas"} class="mobile-link hover:text-purple-400 transition-colors py-1">{isEn ? 'Talks' : 'Charlas'}</a>
      <a href={isEn ? "/en#stack" : "#stack"} class="mobile-link hover:text-purple-400 transition-colors py-1">Stack</a>
      <a href={isEn ? "/en#contacto" : "#contacto"} class="mobile-link hover:text-purple-400 transition-colors py-1">{isEn ? 'Contact' : 'Contacto'}</a>
  </nav>

  <div class="flex flex-col items-center gap-3 w-full max-w-xs shrink-0">
    <a 
      href="https://calendar.app.google/PisvHNBWJNijQxjy7" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-white text-black font-semibold text-xs tracking-wider uppercase hover:bg-neutral-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.2)]"
    >
      <span>{isEn ? 'Schedule Call' : 'Agendar Reunión'}</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
    
    <div class="flex items-center gap-2 text-xs text-neutral-400 font-mono mt-1">
      <span>{isEn ? 'Language:' : 'Idioma:'}</span>
      <a href="/" class={isEn ? "text-neutral-400 hover:text-white" : "text-white font-bold"}>ES</a>
      <span>/</span>
      <a href="/en" class={isEn ? "text-white font-bold" : "text-neutral-400 hover:text-white"}>EN</a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = btn?.querySelector('.menu-icon');
    const closeIcon = btn?.querySelector('.close-icon');
    const links = document.querySelectorAll('.mobile-link');

    const openMenu = () => {
      menu?.classList.remove('translate-x-full');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    };

    const closeMenu = () => {
      menu?.classList.add('translate-x-full');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    const toggleMenu = () => {
      const isOpen = !menu?.classList.contains('translate-x-full');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    };

    btn?.addEventListener('click', toggleMenu);
    
    links.forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  });
</script>