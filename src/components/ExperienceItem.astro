---
interface Props {
  title: string
  company: string
  description: string
  date: string
}

const { title, company, description, date } = Astro.props
---

<div class="flex flex-col gap-1.5">
  <div class="flex items-center gap-3 flex-wrap mb-1">
    <time class="text-xs font-mono font-semibold text-purple-300 tracking-wider uppercase bg-purple-500/10 px-3 py-1 rounded-full border border-purple-500/20">
      {date}
    </time>
    <span class="text-xs font-mono text-neutral-400 uppercase tracking-wider font-semibold">
      {company}
    </span>
  </div>
  <h3 class="text-2xl font-bold text-white group-hover:text-purple-200 transition-colors duration-300">
    {title}
  </h3>
  <p class="text-sm md:text-base text-neutral-400 leading-relaxed max-w-3xl mt-1 font-light">
    {description}
  </p>
</div>