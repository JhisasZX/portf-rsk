---
interface Props {
  title: string
  company: string
  description: string
  date: string
}

const { title, company, description, date } = Astro.props
---

<div class="flex flex-col gap-2">
  <time class="text-sm font-medium text-neutral-500 mb-1 tracking-widest uppercase">{date}</time>
  <h3 class="text-2xl font-bold text-white group-hover:text-purple-400 transition-colors duration-300">
    {title}
  </h3>
  <h4 class="text-lg font-semibold text-neutral-300 mb-4">{company}</h4>
  <p class="text-base text-neutral-400 leading-relaxed max-w-3xl">
    {description}
  </p>
</div>