---
// TrustBar.astro
---
<div class="w-full border-y border-white/5 bg-white/[0.02] py-10 flex flex-col items-center justify-center gap-6 rounded-3xl glow-card">
  <p class="text-sm font-medium text-neutral-400 uppercase tracking-widest">Confían en mi trabajo</p>
  <div class="flex flex-wrap justify-center items-center gap-10 md:gap-20 opacity-50 grayscale transition-all duration-500 hover:grayscale-0 hover:opacity-100">
    <div class="flex items-center gap-2">
      <span class="text-2xl font-black tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-emerald-400">FAVORCITO</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-2xl font-bold tracking-tight text-white">LA CASCADA S.A.</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xl font-bold tracking-tight text-yellow-500">CBN</span>
    </div>
  </div>
</div>
