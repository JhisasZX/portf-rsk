---
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<div class="w-full border border-white/5 bg-neutral-900/40 backdrop-blur-md py-6 px-4 sm:py-8 sm:px-6 flex flex-col items-center justify-center gap-5 sm:gap-6 rounded-2xl md:rounded-3xl shadow-[0_0_50px_rgba(0,0,0,0.5)]">
  <p class="text-[11px] sm:text-xs md:text-sm font-medium text-neutral-400 uppercase tracking-[0.2em] sm:tracking-[0.25em] text-center">
    {caption}
  </p>
  <div class="flex flex-wrap justify-center items-center gap-6 sm:gap-8 md:gap-16 opacity-75 transition-all duration-500 hover:opacity-100">
    <div class="flex items-center gap-2 group">
      <span class="text-xl md:text-2xl font-black tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-emerald-400 group-hover:scale-105 transition-transform">
        FAVORCITO
      </span>
      <span class="text-[10px] text-neutral-500 border border-white/10 px-1.5 py-0.5 rounded uppercase font-mono">Startup</span>
    </div>
    <div class="flex items-center gap-2 group">
      <span class="text-xl md:text-2xl font-extrabold tracking-tight text-white group-hover:text-purple-300 transition-colors">
        LA CASCADA S.A.
      </span>
      <span class="text-[10px] text-neutral-500 border border-white/10 px-1.5 py-0.5 rounded uppercase font-mono">Enterprise</span>
    </div>
    <div class="flex items-center gap-2 group">
      <span class="text-xl md:text-2xl font-black tracking-tight text-amber-400 group-hover:text-amber-300 transition-colors">
        CBN
      </span>
      <span class="text-[10px] text-neutral-500 border border-white/10 px-1.5 py-0.5 rounded uppercase font-mono">Corporate</span>
    </div>
  </div>
</div>
