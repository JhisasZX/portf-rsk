---
// ProjectItem.astro
interface Props {
  title: string;
  description: string;
  role: string;
  tags: string[];
}

const { title, description, role, tags } = Astro.props;
---

<article class="glow-card flex flex-col h-full overflow-hidden group">
  <!-- AQUI VA LA RUTA DE TU IMAGEN: src/assets/proyecto1.webp -->
  <!-- Ejemplo: <img src="/tu-ruta.webp" alt={title} class="w-full h-48 object-cover rounded-xl mb-6 opacity-80 group-hover:opacity-100 transition-opacity" /> -->
  <div class="w-full h-48 bg-white/5 rounded-xl mb-6 flex items-center justify-center border border-white/5">
    <span class="text-neutral-600 font-medium text-sm">[ IMAGEN DEL PROYECTO ]</span>
  </div>

  <div class="mb-4">
    <h3 class="text-2xl font-bold text-white mb-2 tracking-tight">{title}</h3>
    <p class="text-sm text-purple-400 font-semibold mb-4 uppercase tracking-wider">{role}</p>
  </div>
  
  <p class="text-gray-300 text-base leading-relaxed flex-grow mb-6">
    {description}
  </p>
  
  <div class="flex flex-wrap gap-2 mt-auto">
    {tags.map((tag) => (
      <span class="px-3 py-1 bg-neutral-800/50 text-neutral-300 text-xs font-medium rounded-full border border-white/5">
        {tag}
      </span>
    ))}
  </div>
</article>
