---
// ProjectItem.astro
interface Props {
  title: string;
  description: string;
  role: string;
  tags: string[];
  badge?: string;
  highlight?: string;
  link?: string;
}

const { title, description, role, tags, badge, highlight, link } = Astro.props;
---

<article class="glow-card flex flex-col h-full relative overflow-hidden group hover:border-purple-500/40 transition-all duration-500">
  <!-- Top glow accent line -->
  <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-purple-500/20 to-transparent group-hover:via-purple-400 transition-all duration-500"></div>

  <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
    {badge && (
      <span class="text-[11px] font-mono tracking-wider uppercase px-2.5 py-1 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20">
        {badge}
      </span>
    )}
    {highlight && (
      <span class="text-[11px] font-mono tracking-wider uppercase text-emerald-400/90 flex items-center gap-1.5 ml-auto">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        {highlight}
      </span>
    )}
  </div>

  <div class="mb-3">
    <h3 class="text-xl sm:text-2xl font-bold text-white mb-1 tracking-tight group-hover:text-purple-200 transition-colors">
      {title}
    </h3>
    <p class="text-xs text-purple-400 font-semibold uppercase tracking-wider font-mono">
      {role}
    </p>
  </div>
  
  <p class="text-neutral-300 text-sm md:text-base leading-relaxed flex-grow mb-6">
    {description}
  </p>
  
  <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-white/5">
    {tags.map((tag) => (
      <span class="px-2.5 py-1 bg-white/[0.03] text-neutral-300 text-xs font-medium rounded-lg border border-white/10 group-hover:border-purple-500/20 transition-colors">
        {tag}
      </span>
    ))}
  </div>
</article>
