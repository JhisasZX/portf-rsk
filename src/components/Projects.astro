---
import ProjectItem from "./ProjectItem.astro";

const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en');

const PROJECTS = [
  {
    title: isEn ? "Security & Operational Control App" : "App de Seguridad y Control Operativo",
    description: isEn ? "Lead the development of a comprehensive mobile application for managing truck logs and security guard protocols." : "Liderazgo en el desarrollo de una aplicación móvil integral para la gestión de bitácoras de camiones y protocolos de guardias de seguridad.",
    role: isEn ? "Lead / Developer" : "Liderazgo / Desarrollo",
    tags: ["Flutter", "Figma (UI/UX)", "MySQL"],
  },
  {
    title: isEn ? "SIC Project Phase 3" : "Proyecto SIC Fase 3",
    description: isEn ? "Deep refactoring and migration of a mobile app from a legacy architecture to a new scalable structure, including dependency synchronization and package renaming." : "Refactorización profunda y migración de una aplicación móvil desde una arquitectura legacy hacia una nueva estructura escalable, incluyendo sincronización de dependencias y renombramiento de paquetes.",
    role: isEn ? "Architect / Developer" : "Arquitecto / Desarrollador",
    tags: ["Flutter", "Software Architecture"],
  }
];
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
  {PROJECTS.map((project) => (
    <ProjectItem {...project} />
  ))}
</div>
