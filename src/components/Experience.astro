---
import ExperienceItem from "./ExperienceItem.astro"

const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en');

const EXPERIENCE = [
  {
    date: isEn ? "Nov 2025 - Present" : "Nov 2025 - Actualidad",
    title: "Development and Maintenance Analyst",
    company: "La Cascada S.A.",
    description: isEn ? "Development of corporate mobile apps. Led the scratch creation of an internal CRM (SIC Project) for marketing presales, implementing robust offline-first architectures to guarantee performance in areas with unstable connectivity." : "Desarrollo de aplicaciones móviles corporativas. Lideré la creación desde cero de un CRM interno (Proyecto SIC) para el empadronamiento y preventa MKT, e implementé arquitecturas robustas offline-first para garantizar el rendimiento en áreas con conectividad inestable.",
  },
  {
    date: isEn ? "Apr 2025 - Nov 2025" : "Abr 2025 - Nov 2025",
    title: "Tech Lead Mobile & Frontend Dev",
    company: "Start Up Favorcito",
    description: isEn ? "Rapid evolution from Frontend Dev to Tech Lead. Led the development and implementation of new features for client and student apps, keeping the platform at the forefront with the latest technologies of the Flutter ecosystem." : "Evolución rápida de Frontend Dev a Tech Lead. Lideré el desarrollo e implementación de nuevas features para las apps de clientes y estudiantes, manteniendo la plataforma a la vanguardia con las últimas tecnologías del ecosistema Flutter.",
  }
]
---

<div class="relative mt-16 border-l border-white/10 ml-3 md:ml-6">
  {
    EXPERIENCE.map((experience) => (
      <div class="mb-14 ml-8 md:ml-12 group">
        <span class="absolute flex items-center justify-center w-6 h-6 bg-neutral-900 rounded-full -left-[12px] ring-4 ring-[#0a0a0a] border border-purple-500/30 group-hover:bg-purple-500/20 group-hover:border-purple-400 group-hover:shadow-[0_0_15px_rgba(168,85,247,0.5)] transition-all duration-300">
          <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
        </span>
        <ExperienceItem {...experience} />
      </div>
    ))
  }
</div>