---
import ExperienceItem from "./ExperienceItem.astro";
import type { Experience } from "../data/portfolio";

interface Props {
  experience: Experience[];
}

const { experience } = Astro.props;
---

<div class="relative mt-16 border-l border-white/10 ml-3 md:ml-6">
  {
    experience.map((item) => (
      <div class="mb-14 ml-8 md:ml-12 group">
        <span class="absolute flex items-center justify-center w-6 h-6 bg-neutral-900 rounded-full -left-[12px] ring-4 ring-[#0a0a0a] border border-purple-500/30 group-hover:bg-purple-500/20 group-hover:border-purple-400 group-hover:shadow-[0_0_15px_rgba(168,85,247,0.5)] transition-all duration-300">
          <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
        </span>
        <ExperienceItem {...item} />
      </div>
    ))
  }
</div>