---
import Layout from "../../layouts/Layout.astro";
import LinkedInIcon from "../../components/icons/linkedin_icon.astro";
import GithubIcon from "../../components/icons/github_icon.astro";
import InstagramIcon from "../../components/icons/instagram_icon.astro";
import SpotifyIcon from "../../components/icons/spotify_icon.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import Experience from "../../components/Experience.astro";
import Projects from "../../components/Projects.astro";
import StackGrid from "../../components/StackGrid.astro";
import TrustBar from "../../components/TrustBar.astro";
import Talks from "../../components/Talks.astro";
---

<Layout
  title="Jesús Machicado — Tech Lead & Mobile Systems Engineer"
  description="Portfolio of Jesús Machicado: Systems Engineer, Tech Lead & Mobile Developer (Flutter, React). Specialized in offline-first architectures, Clean Architecture, and high-impact scalable apps."
>
  <!-- Floating Social Dock -->
  <div class="fixed bottom-3 right-3 sm:bottom-6 sm:right-6 md:bottom-8 md:right-8 z-50 flex flex-col gap-2.5 sm:gap-3 md:gap-4 scale-[0.8] sm:scale-90 md:scale-100 origin-bottom-right">
    <a
      href="https://github.com/JhisasZX"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub Profile"
      class="group relative p-2.5 sm:p-3 bg-neutral-900/60 backdrop-blur-md border border-white/10 rounded-full hover:bg-white/10 hover:border-white/20 hover:-translate-y-1 transition-all duration-300"
    >
      <GithubIcon class="w-5 h-5 text-neutral-400 group-hover:text-white" />
    </a>

    <a
      href="https://www.linkedin.com/in/jmachruiz/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn Profile"
      class="group relative p-2.5 sm:p-3 bg-neutral-900/60 backdrop-blur-md border border-white/10 rounded-full hover:bg-blue-500/20 hover:border-blue-500/50 hover:-translate-y-1 transition-all duration-300"
    >
      <LinkedInIcon
        class="w-5 h-5 text-neutral-400 group-hover:text-blue-400"
      />
    </a>

    <a
      href="https://www.instagram.com/jhisas_zx/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram Profile"
      class="group relative p-2.5 sm:p-3 bg-neutral-900/60 backdrop-blur-md border border-white/10 rounded-full hover:bg-pink-500/20 hover:border-pink-500/50 hover:-translate-y-1 transition-all duration-300"
    >
      <InstagramIcon
        class="w-5 h-5 text-neutral-400 group-hover:text-pink-400"
      />
    </a>

    <a
      href="https://open.spotify.com/user/jhisasxt?si=6bf9e84697e344ba"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Spotify Profile"
      class="group relative p-2.5 sm:p-3 bg-neutral-900/60 backdrop-blur-md border border-white/10 rounded-full hover:bg-[#1DB954]/20 hover:border-[#1DB954]/50 hover:-translate-y-1 transition-all duration-300"
    >
      <div
        class="absolute right-full mr-4 top-1/2 -translate-y-1/2 px-3 py-1.5 bg-[#1DB954]/10 text-[#1DB954] border border-[#1DB954]/20 rounded-lg text-xs font-semibold whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none backdrop-blur-md hidden sm:block"
      >
        Listen with me 🎧
      </div>
      <SpotifyIcon
        class="w-5 h-5 text-neutral-400 group-hover:text-[#1DB954]"
      />
    </a>
  </div>

  <main id="top" class="px-4 sm:px-6 max-w-6xl mx-auto">
    <!-- HERO SECTION -->
    <SectionContainer
      class="min-h-[85vh] sm:min-h-screen flex flex-col justify-center py-12 sm:py-20 relative z-10"
    >
      <!-- Live Status Badge -->
      <a href="https://calendar.app.google/PisvHNBWJNijQxjy7" target="_blank" rel="noopener noreferrer" class="mb-5 sm:mb-6 inline-flex items-center gap-2 sm:gap-2.5 px-3.5 sm:px-4 py-1 sm:py-1.5 bg-emerald-500/10 border border-emerald-500/25 rounded-full text-[11px] sm:text-xs font-mono text-emerald-300 tracking-wider hover:bg-emerald-500/15 hover:border-emerald-400/40 transition-all duration-300 w-fit max-w-full group">
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
        </span>
        <span class="group-hover:text-white transition-colors truncate">
          <span class="hidden sm:inline">AVAILABLE FOR NEW PROJECTS &bull; TECH LEAD</span>
          <span class="sm:hidden">AVAILABLE &bull; TECH LEAD MOBILE</span>
        </span>
      </a>

      <h1
        class="text-4xl sm:text-6xl md:text-8xl lg:text-9xl font-bold tracking-tighter text-white leading-[1.08] mb-5 sm:mb-8"
      >
        code with logic,<br />
        <span
          class="font-playfair italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-purple-300 via-pink-300 to-orange-300"
          >build with impact.</span
        >
      </h1>

      <p
        class="text-lg sm:text-xl md:text-2xl text-neutral-400 max-w-3xl leading-relaxed font-light mb-8"
      >
        Hi, I'm <span class="text-white font-medium">Jesús Machicado</span>. <br />
        Systems Engineer & Mobile Tech Lead (Flutter). Specialized in Clean Architecture,
        mission-critical offline-first solutions, and high-impact web and mobile products.
      </p>

      <!-- Action Buttons (CTAs) -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 mb-8 sm:mb-10 w-full sm:w-auto">
        <a 
          href="#proyectos" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-black font-semibold rounded-full hover:bg-neutral-200 hover:scale-105 active:scale-95 transition-all text-sm shadow-[0_0_30px_rgba(255,255,255,0.25)]"
        >
          <span>Explore Projects</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
        </a>

        <a 
          href="https://calendar.app.google/PisvHNBWJNijQxjy7" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-white/5 border border-white/10 text-white font-medium rounded-full hover:bg-white/10 hover:border-purple-500/40 hover:scale-105 active:scale-95 transition-all text-sm backdrop-blur-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-400"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>Schedule a Call</span>
        </a>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6 pt-5 sm:pt-6 border-t border-white/10 mb-8 max-w-2xl">
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-white tracking-tight font-mono">+3 Years</div>
          <div class="text-xs text-neutral-400 font-light mt-0.5">Mobile & Web Dev</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-white tracking-tight font-mono">5+ Apps</div>
          <div class="text-xs text-neutral-400 font-light mt-0.5">Production & Architecture</div>
        </div>
        <div class="col-span-2 sm:col-span-1 pt-2 sm:pt-0 border-t sm:border-t-0 border-white/5">
          <div class="text-2xl sm:text-3xl font-bold text-emerald-400 tracking-tight font-mono">100%</div>
          <div class="text-xs text-neutral-400 font-light mt-0.5">Offline-First & Clean Arch</div>
        </div>
      </div>

      <!-- TRUST BAR SOCIAL PROOF -->
      <div class="w-full mt-2">
        <TrustBar />
      </div>
    </SectionContainer>

    <!-- EXPERIENCE -->
    <SectionContainer class="pb-24 md:pb-44 reveal" id="experiencia">
      <h2 class="text-3xl md:text-5xl font-playfair italic mb-8 md:mb-16 text-white/90">
        Experience.
      </h2>
      <Experience />
    </SectionContainer>

    <!-- PROYECTOS -->
    <SectionContainer class="pb-24 md:pb-44 reveal" id="proyectos">
      <div class="flex items-baseline justify-between mb-8 md:mb-16 flex-wrap gap-4">
        <h2 class="text-3xl md:text-5xl font-playfair italic text-white/90">
          Selected Works.
        </h2>
        <span class="text-xs md:text-sm text-neutral-400 font-mono tracking-widest uppercase">
          Thesis &bull; Hackathons &bull; Enterprise
        </span>
      </div>
      <Projects />
    </SectionContainer>

    <!-- KEYNOTE & TALKS -->
    <SectionContainer class="pb-24 md:pb-44 reveal" id="charlas">
      <h2 class="text-3xl md:text-5xl font-playfair italic mb-8 md:mb-16 text-white/90">
        Keynotes & Community.
      </h2>
      <Talks />
    </SectionContainer>

    <!-- TECH STACK -->
    <SectionContainer class="pb-24 md:pb-44 reveal" id="stack">
      <h2 class="text-3xl md:text-5xl font-playfair italic mb-8 md:mb-16 text-white/90">
        Tech Stack.
      </h2>
      <StackGrid />
    </SectionContainer>

    <!-- ABOUT ME / CTA -->
    <SectionContainer
      id="contacto"
      class="pb-24 pt-12 md:pb-44 md:pt-20 reveal border-t border-white/10 text-center"
    >
      <h2 class="text-3xl sm:text-4xl md:text-6xl font-bold tracking-tight mb-8">
        Let's build together.
      </h2>
      <p
        class="text-xl text-neutral-400 max-w-2xl mx-auto mb-12 leading-relaxed"
      >
        Always open to collaborate, lead technical architectures, and solve complex problems
        with clean, high-performance code.
      </p>
      <a
        href="https://www.linkedin.com/in/jmachruiz/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-6 py-3 md:px-8 md:py-4 text-sm md:text-base font-medium text-white bg-white/5 border border-white/10 rounded-full hover:bg-white/10 hover:scale-105 transition-all duration-300 glow-card hover:border-white/20"
      >
        Connect on LinkedIn &rarr;
      </a>
      
      <p class="mt-16 md:mt-24 text-sm font-playfair italic text-neutral-600">"bloom to death."</p>
    </SectionContainer>
  </main>
</Layout>
